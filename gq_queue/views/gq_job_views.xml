<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List view ──────────────────────────────────────────────────────── -->

    <record id="gq_job_view_tree" model="ir.ui.view">
        <field name="name">gq.job.list</field>
        <field name="model">gq.job</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'failed'"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'done'"
                  decoration-warning="state == 'started'"
                  decoration-info="state == 'waiting'">
                <header>
                    <button name="action_requeue" type="object" string="Requeue"/>
                    <button name="action_cancel" type="object" string="Cancel"/>
                </header>
                <field name="name"/>
                <field name="model_name"/>
                <field name="method_name"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="group_uuid" optional="hide"/>
                <field name="user_id" optional="show"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="eta"/>
                <field name="retry_count"/>
                <field name="exc_name" optional="hide"/>
                <field name="exec_time" optional="hide"/>
                <field name="date_created"/>
                <field name="date_done"/>
            </list>
        </field>
    </record>

    <!-- ── Form view ──────────────────────────────────────────────────────── -->

    <record id="gq_job_view_form" model="ir.ui.view">
        <field name="name">gq.job.form</field>
        <field name="model">gq.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_requeue" type="object" string="Requeue"
                            class="oe_highlight"
                            invisible="state not in ('failed', 'cancelled', 'done')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('waiting', 'pending', 'failed')"/>
                    <button name="action_cancel_group" type="object" string="Cancel Group"
                            invisible="not group_uuid"
                            confirm="Cancel every job of this group that has not run yet?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="waiting,pending,started,done,failed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" invisible="not group_uuid">
                        <button name="action_view_group" type="object"
                                class="oe_stat_button" icon="fa-tasks">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="group_done_count"/> /
                                    <field name="group_job_count"/>
                                </span>
                                <span class="o_stat_text">Group Done</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group string="Job">
                            <field name="name"/>
                            <field name="uuid"/>
                            <field name="identity_key"/>
                            <field name="group_uuid"/>
                            <field name="priority"/>
                        </group>
                        <group string="Execution">
                            <field name="model_name"/>
                            <field name="method_name"/>
                            <field name="eta"/>
                            <field name="max_retries"/>
                            <field name="retry_count"/>
                        </group>
                        <group string="Environment">
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="run_sudo"/>
                            <field name="context"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Arguments">
                            <group>
                                <field name="record_ids"/>
                                <field name="args"/>
                                <field name="kwargs"/>
                            </group>
                        </page>
                        <page string="Dependencies">
                            <group string="Depends On">
                                <field name="depends_on_ids" nolabel="1" colspan="2">
                                    <list>
                                        <field name="name"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Dependent Jobs">
                                <field name="dependent_ids" nolabel="1" colspan="2">
                                    <list>
                                        <field name="name"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Result">
                            <group>
                                <field name="result"/>
                            </group>
                            <group>
                                <field name="exc_name"/>
                                <field name="exc_message"/>
                                <field name="exc_info" widget="text"/>
                            </group>
                        </page>
                        <page string="Dates">
                            <group>
                                <field name="date_created"/>
                                <field name="date_enqueued"/>
                                <field name="date_started"/>
                                <field name="date_done"/>
                                <field name="date_cancelled"/>
                                <field name="exec_time"/>
                                <field name="worker_pid"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search view ────────────────────────────────────────────────────── -->

    <record id="gq_job_view_search" model="ir.ui.view">
        <field name="name">gq.job.search</field>
        <field name="model">gq.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_name"/>
                <field name="method_name"/>
                <field name="group_uuid"/>
                <field name="exc_name"/>
                <field name="exc_message"/>
                <filter name="waiting" string="Waiting"
                        domain="[('state','=','waiting')]"/>
                <filter name="pending" string="Pending"
                        domain="[('state','=','pending')]"/>
                <filter name="started" string="Running"
                        domain="[('state','=','started')]"/>
                <filter name="failed" string="Failed"
                        domain="[('state','=','failed')]"/>
                <filter name="done" string="Done"
                        domain="[('state','=','done')]"/>
                <filter name="cancelled" string="Cancelled"
                        domain="[('state','=','cancelled')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_model" string="Model"
                            context="{'group_by': 'model_name'}"/>
                    <filter name="group_exception" string="Exception"
                            context="{'group_by': 'exc_name'}"/>
                    <filter name="group_group" string="Group"
                            context="{'group_by': 'group_uuid'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────────────────────── -->

    <record id="gq_job_action" model="ir.actions.act_window">
        <field name="name">GQ Queue Jobs</field>
        <field name="res_model">gq.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="gq_job_view_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <!-- ── Menu ───────────────────────────────────────────────────────────── -->

    <menuitem
        id="gq_queue_menu_root"
        name="GQ Queue"
        groups="base.group_system"
        sequence="100"/>

    <menuitem
        id="gq_queue_menu_jobs"
        name="Jobs"
        parent="gq_queue_menu_root"
        action="gq_job_action"
        sequence="10"/>

</odoo>
