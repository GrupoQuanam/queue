<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="gq_job_function_view_list" model="ir.ui.view">
        <field name="name">gq.job.function.list</field>
        <field name="model">gq.job.function</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="retry_pattern"/>
                <field name="on_fail_method"/>
            </list>
        </field>
    </record>

    <record id="gq_job_function_view_form" model="ir.ui.view">
        <field name="name">gq.job.function.form</field>
        <field name="model">gq.job.function</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Function">
                            <field name="model_id"/>
                            <field name="method"/>
                            <field name="name"/>
                        </group>
                        <group string="Jobs">
                            <field name="retry_pattern" placeholder="{1: 10, 5: 60, 10: 300}"/>
                            <field name="on_fail_method"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gq_job_function_view_search" model="ir.ui.view">
        <field name="name">gq.job.function.search</field>
        <field name="model">gq.job.function</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="gq_job_function_action" model="ir.actions.act_window">
        <field name="name">GQ Queue Job Functions</field>
        <field name="res_model">gq.job.function</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="gq_queue_menu_functions"
        name="Job Functions"
        parent="gq_queue_menu_root"
        action="gq_job_function_action"
        sequence="20"/>

</odoo>
