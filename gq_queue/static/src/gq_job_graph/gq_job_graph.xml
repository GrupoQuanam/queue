<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="gq_queue.GQJobGraph">
        <div class="o_gq_job_graph">
            <div t-if="graph.truncated" class="alert alert-warning mb-2">
                The graph is too big: only part of it is shown.
            </div>
            <t t-set="view" t-value="layout"/>
            <svg t-if="view.boxes.length"
                 t-att-width="view.width" t-att-height="view.height"
                 t-att-viewBox="'0 0 ' + view.width + ' ' + view.height">
                <defs>
                    <marker id="o_gq_arrow" viewBox="0 0 10 10" refX="9" refY="5"
                            markerWidth="8" markerHeight="8" orient="auto-start-reverse">
                        <path d="M0,0 L10,5 L0,10 z" class="o_gq_arrow"/>
                    </marker>
                </defs>
                <path t-foreach="view.paths" t-as="edge" t-key="edge.key"
                      t-att-d="edge.d" class="o_gq_edge" marker-end="url(#o_gq_arrow)"/>
                <g t-foreach="view.boxes" t-as="node" t-key="node.id"
                   t-att-class="'o_gq_node o_gq_node_' + node.state + (node.current ? ' o_gq_node_current' : '')"
                   t-att-transform="'translate(' + node.x + ',' + node.y + ')'"
                   t-on-click="() => this.openJob(node)">
                    <title t-esc="node.title"/>
                    <rect t-att-width="view.nodeWidth" t-att-height="view.nodeHeight" rx="6"/>
                    <text x="10" t-att-y="view.nodeHeight / 2" dominant-baseline="middle"
                          t-esc="node.label"/>
                </g>
            </svg>
        </div>
    </t>

</templates>
